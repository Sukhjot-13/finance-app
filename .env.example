# FinTrack environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Required -------------------------------------------------------------

# MongoDB connection string. Also backs the rate-limit collection.
# Example: mongodb+srv://user:password@cluster.mongodb.net/fintrack_db?retryWrites=true&w=majority
MONGODB_URI=

# Brevo (formerly Sendinblue) API key for sending the sign-in OTP emails.
BREVO_API_KEY=

# Verified sender email for Brevo.
EMAIL_FROM=

# JWT signing secrets. Generate each with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Manager (centralized logging + analytics) — OPTIONAL.
# With none of these set the whole integration is a set of no-ops: the app
# behaves exactly as before. Read by src/lib/manager/index.js.
# ---------------------------------------------------------------------------

# Base URL of the Manager deployment. Required to enable the integration.
MANAGER_ENDPOINT=http://127.0.0.1:3300

# Project slug in Manager. Required to enable the integration.
MANAGER_APP_ID=finance-app

# Project SERVER log key (`mlk_…`). Required to enable the integration.
MANAGER_LOG_KEY=

# Analytics key (`mak_…`) for the injected tracker script. Optional:
# logs still work without it.
MANAGER_ANALYTICS_KEY=

# Optional. `server` (default) or `client`. Inferred when omitted.
MANAGER_LOG_SOURCE=server

# --- Browser half ---------------------------------------------------------
# Next.js only inlines NEXT_PUBLIC_* into the client bundle, so the browser
# CANNOT read the MANAGER_* values above (process.env is empty in browser
# code). Without this block ManagerProvider stays silently disabled and no
# browser logs or analytics are ever sent.
#
# MANAGER_CLIENT_KEY is the project's browser key (`mck_…`). Do NOT reuse
# MANAGER_LOG_KEY here: Manager derives each entry's source from the key kind,
# so browser entries should carry the client key.
#
# NEXT_PUBLIC_MANAGER_ENDPOINT is also read by src/proxy.js, which adds it to
# the page CSP `connect-src` so the browser logger is not blocked.
NEXT_PUBLIC_MANAGER_ENDPOINT=http://127.0.0.1:3300
NEXT_PUBLIC_MANAGER_APP_ID=finance-app
NEXT_PUBLIC_MANAGER_CLIENT_KEY=
NEXT_PUBLIC_MANAGER_ANALYTICS_KEY=
