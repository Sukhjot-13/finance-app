# FinTrack environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Required -------------------------------------------------------------

# MongoDB connection string. Also backs the rate-limit collection.
# Example: mongodb+srv://user:password@cluster.mongodb.net/fintrack_db?retryWrites=true&w=majority
MONGODB_URI=

# Brevo (formerly Sendinblue) API key for sending the sign-in OTP emails.
BREVO_API_KEY=

# Verified sender email for Brevo.
EMAIL_FROM=

# JWT signing secrets. Generate each with: openssl rand -base64 32
# They must be DIFFERENT from each other and at least 32 characters long; the app
# warns at runtime when either is violated.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Manager (centralized logging + analytics) — OPTIONAL.
# With none of these set the whole integration is a set of no-ops: the app
# behaves exactly as before. Read by src/lib/manager/config.js.
# Full contract + troubleshooting: README.md § "Manager integration".
# ---------------------------------------------------------------------------

# Base URL of the MANAGER deployment — this app's own port is NOT it, and
# neither is /api/ingest/logs. (Manager's own local default is
# http://127.0.0.1:3300.) Required to enable the integration.
MANAGER_ENDPOINT=http://127.0.0.1:3300

# Project slug in Manager. Required to enable the integration.
MANAGER_APP_ID=finance-app

# Project SERVER log key (`mlk_…`). Server-only.
# NEVER put this in a NEXT_PUBLIC_ variable, in HTML, or anywhere a browser
# can read it. Required to enable server logging.
MANAGER_LOG_KEY=

# ---------------------------------------------------------------------------
# Browser half.
#
# Next.js inlines NEXT_PUBLIC_* into the client bundle AT BUILD TIME, so these
# need a `npm run build` (not just a restart) to take effect. Without this block
# ManagerProvider stays disabled and no browser logs or analytics are sent.
#
# Use the project's CLIENT key (`mck_…`) — never MANAGER_LOG_KEY above.
# MANAGER_CLIENT_KEY is what scripts/check-manager-integration.mjs expects
# (it also accepts NEXT_PUBLIC_MANAGER_CLIENT_KEY).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_MANAGER_ENDPOINT=http://127.0.0.1:3300
NEXT_PUBLIC_MANAGER_APP_ID=finance-app
NEXT_PUBLIC_MANAGER_CLIENT_KEY=

# Analytics key (`mak_…`) for the injected tracker <script>. Optional and
# INDEPENDENT of the client log key: analytics still works with no client log
# key, and browser logging still works with no analytics key.
NEXT_PUBLIC_MANAGER_ANALYTICS_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Optional release label attached to browser log entries. Falls back to "web".
# NEXT_PUBLIC_RELEASE=

# ---------------------------------------------------------------------------
# scripts/check-manager-integration.mjs reads these; they are NOT app config.
# ---------------------------------------------------------------------------
# MANAGER_CLIENT_KEY   = same mck_… value as NEXT_PUBLIC_MANAGER_CLIENT_KEY
# APP_ORIGIN          = a running FinTrack (default http://127.0.0.1:3000)
# APP_COOKIE          = "accessToken=…; refreshToken=…" to enable the
#                       authenticated probes (otherwise they are SKIPPED)
# APP_ORIGIN_DEGRADED = a FinTrack started with an unreachable MANAGER_ENDPOINT,
#                       to prove the app does not block on Manager
